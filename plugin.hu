{
    // configsys-user — spacemeat's personal configsys layer (profiles, components, dotfiles).
    // Designated `primary: true` in the machine's top ~/.config/configsys/configsys.hu, so its
    // machine settings (configs / scope / pins) apply as this account's portable defaults, with
    // the top config overriding per-machine. Ships no code — just data + dotfiles.
    name: configsys-user
    requires-abi: 1

    data: [ configsys.hu ]

    plugins: [
        { source: "github:spacemeat/configsys-blender"  ref: v0.1.6 }
        { source: "github:spacemeat/configsys-kicad"  ref: v0.1.3 }
        { source: "github:spacemeat/configsys-source"  ref: v0.1.0 }
        { source: "github:spacemeat/configsys-splash-ocean"  ref: v0.1.0 }
        { source: "github:spacemeat/configsys-splash-blocks"  ref: v0.1.0 }
        { source: "github:spacemeat/configsys-opencv"  ref: v0.1.2 }
    ]
}
