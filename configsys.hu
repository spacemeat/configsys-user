{
    components: {
        // apod: a PyPI CLI (termapod) installed via pipx, plus a shell-startup dotfile.
        // `via: pipx` pulls the pipx TOOL (the driver's requires) — which is itself the
        // version-variant component above (pip-bootstrap on old Ubuntu/Debian, +EPEL on EL),
        // so this is a two-level tool chain. The inline dotfiles field runs termapod on every
        // interactive shell. (Old: linux `apod: [ pipx\apod, dotfiles\apod ]`.)
        apod: {
            suggests: apod-dotfiles
            install: [ { via: pipx  name: termapod  version: { pypi: termapod } } ]
        }
        apod-dotfiles: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         // src: bash.d/apod.sh  dst: ~/.bash.d/apod.sh } ]
                         config:  { src: apod  dst: $XDG_CONFIG_HOME/apod }
                         aliases: { glue: apod } } ]
        }

        best-ps1: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         //src: bash.d/ps1.sh  dst: ~/.bash.d/ps1.sh 
                         glue: ps1 } ]
        }
    }
    splash: random
    adopt-installed: true
    driver-preference: [ native  flatpak  snap  native-pkg-file  appImage  tarball  source  script ]
    picks: {
        laptop: [ impala  asio  bzip2  expat  ffmpeg-dev  fuse  libaio  libcurl  libdrm-dev  libdwarf  libevent  libgit2  libiberty  libidn2  liblz4  libmagic  libmtp  libpcap  libsecret  libsodium  libunwind  liburing  libusb  libzstd  ncurses  nng  opencascade  openssl  pipewire-dev  sdl2-image  sdl2-ttf  snappy  sqlite  tinyxml2  unixodbc  zlib  bazelisk  cabal  ccmake  clang  clang-18  clang-19  clang-20  clangd  cmake  cmake-gui  conan  cpp-toolchain  doxygen  gcc-10  gcc-11  gcc-12  gcc-13  gcc-14  gcc-15  gdb  gettext  go  goimports  haskell  heaptrack  hlint  make  meson  ninja  jmtpfs  jack  pipewire  wiremix  ardour  audacity  carla  espeak  hydrogen  lmms  musescore  pulseaudio-utils  qjackctl  sonic-pi  supercollider  tenacity  yabridge  autoconf  automake  bison  flex  libtool  pkg-config  docker  docker-group  lazydocker  podman  redis-service  bluetui  curl  dig  dnspeep  ethtool  gping  iftop  iperf3  iproute2  mtr  netcat  nethogs  nload  nmap  rsync  socat  tcpdump  traceroute  tshark  vnstat  whois  wireshark  wireshark-group  abseil  dbus-dev  double-conversion  eastl  fast_float  fastcdr  fastdds  fmt  folly  foonathan-memory  gflags  glog  protobuf-dev  swig  clojure  leiningen  discord  discordo  slack  lz4  p7zip  rar  unrar  unzip  zip  zstd  cuda  arduino  gnuradio  blender  chafa  figlet  grim  pastel  slurp  swaybg  gnome  libreoffice  alacritty  apod  balena-etcher  bat  boost  bruno  btop  c-toolchain  cairo  chrome  clang-tidy  claude-code  cppcheck  cuda-toolkit-11  cuda-toolkit-12  cython  docker-engine  docker-service  duf  egl  erlang  fastfetch  fd  ffmpeg  firefox  flatpak  fontconfig  fzf  gfortran  gh  git  git-lfs  glew  glfw  glm  gnupg  gnuplot  godots  gradle  groovy  gst-bad  gst-good  gst-libav  gtk  gtk3  gtkmm  gum  htop  httpie  insomnia  jdk  jdk-21  jq  jupyterlab  kitty  kodi  lazysql  libdecor  libfuse2  libinput  libjpeg  libpng  libstdc++  libvirt  libvirt-clients  libvulkan1  libx11  libxcb  libxcb-cursor-dev  l