{
    // Shared, git-synced profile definitions. Per-machine selection + overrides live in
    // ~/configsys.hu, which overlays this file section-by-section (see docs/routing-model.md).
    //configs: [ user  gaming  dev  electronics  graphics  sculpture-artist  science ]
configs: [ ts-desktop  ts-laptop ]

    profiles: {
        ts-dev-system: [ analysis  make  ninja  rust  luarocks  lua  jq  yq  perf  git  nasm  just  protobuf  sqlite  sqlitebrowser  vscode  bazelisk ]
        ts-dev-cuda: [ cuda  cudnn  cuda-toolkit  cuda-repo  cuda-toolkit-11  cuda-toolkit-12  cudnn-8  cudnn-9  rocm-hip ]
        ts-dev-c-cpp: [ cmake  cpp-toolchain  gcc-10  gcc-11  gcc-12  gcc-13  gcc-14  gcc-15  gdb  folly  clang-18  clang-19  clang-20  make  meson  ninja  analysis  eastl  boost  bison  flex  abseil  clang-select  clang-tidy  gcc-select  conan  cppcheck  gtkmm  gtk  heaptrack  pkg-config  fmt  gdb-dotfiles  gflags  glog  double-conversion  fast_float  expat  libevent  libdwarf  libiberty  liblz4  libmagic  libaio  libsodium  libunwind  liburing  libzstd  lldb  ncurses  bzip2  intel-oneapi-basekit  libtool  libusb  qt  vcpkg ]
        ts-dev-rust: [ rust  miniforge ]
        ts-dev-lua: [ dkjson ]
        ts-dev-science: [ opencv  octave  opencv-python  fastdds  jupyterlab ]
        ts-dev-vulkan: [ vulkan-dev ]
        ts-dev-web: [ typescript  node  sass  prettier  grpcurl  postman  httpie  xh ]
        ts-llm: [ aider  claude-code  codex  ollama  llm ]
        ts-user: [ bash-dotfiles  configsys-dotfiles  apod  best-ps1  apod-dotfiles  git ]
        ts-containers: [ docker  docker-group  podman  lazydocker  podman-dotfiles ]
        ts-net-tools: [ dig  ethtool  iftop  iperf3  iproute2  mtr  netcat  nethogs  nload  nmap  socat  tcpdump  traceroute  tshark  vnstat  websocat  whois  wireshark  wireshark-group  mitmproxy ]
        ts-terminal: [ neovim  curl  fastfetch  fzf  htop  lazygit  mononoki-nerd  ripgrep  tmux  xclip  yazi  neovim-dotfiles  lazydocker  lazygit-dotfiles  lazysql  htop-dotfiles  ffmpeg  xclip-dotfiles  yazi-dotfiles ]
        ts-virt: [ qemu  libvirt  libvirt-service  virt-manager  virtualbox ]
        ts-desktop-gaming: [ steam  vulkan-runtime ]
        ts-desktop-graphics: [ vulkan-runtime  gimp  inkscape  krita  blender  freecad ]
        ts-desktop-electronics: [ arduino  kicad  arduino-dotfiles ]
        ts-desktop-audio: [ ardour  lmms  pipewire  tenacity  spotify ]
        ts-desktop-apps: [ discord  libreoffice  vlc ]
        ts-laptop-graphics: [ blender  mesa-vulkan-drivers  gimp  inkscape  krita ]
        ts-laptop-electronics: [ arduino  gnuradio  kicad  arduino-dotfiles ]
        ts-laptop-audio: [ ardour  lmms  pipewire  tenacity  spotify ]
        ts-laptop-apps: [ discord  libreoffice  vlc ]
        ts-desktop: [ +ts-dev-system  +ts-dev-c-cpp  +ts-dev-science  +ts-dev-vulkan  +ts-dev-web  +ts-user  +ts-containers  +ts-net-tools  +ts-terminal  +ts-virt  +ts-desktop-graphics  +ts-desktop-electronics  +ts-desktop-audio  +ts-desktop-apps  python3-pip ]
        ts-laptop: [ +ts-dev-system  +ts-dev-c-cpp  +ts-dev-science  +ts-dev-vulkan  +ts-dev-web  +ts-user  +ts-containers  +ts-net-tools  +ts-terminal  +ts-virt  +ts-laptop-graphics  +ts-laptop-electronics  +ts-laptop-audio  +ts-laptop-apps  python3-pip ]
        ts-android: [ jmtpfs  android-studio ]
        terminal: [ +terminal  lazygit-dotfiles ]
        ts-dev-python: [ pyenv  python3.11  python3.12  python3.13  cython  jupyterlab ]
    }

    components: {
        // apod: a PyPI CLI (termapod) installed via pipx, plus a shell-startup dotfile.
        // `via: pipx` pulls the pipx TOOL (the driver's requires) — which is itself the
        // version-variant component above (pip-bootstrap on old Ubuntu/Debian, +EPEL on EL),
        // so this is a two-level tool chain. The inline dotfiles field runs termapod on every
        // interactive shell. (Old: linux `apod: [ pipx\apod, dotfiles\apod ]`.)
        apod: {
            suggests: apod-dotfiles
            install: [ { via: pipx  name: termapod  version: { pypi: termapod } } ]
        }
        apod-dotfiles: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         src: bash.d/apod.sh  dst: ~/.bash.d/apod.sh } ]
        }

        neovim-dotfiles: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         config:  { src: neovim         dst: $XDG_CONFIG_HOME/nvim }
                         aliases: { src: bash.d/neovim.sh  dst: ~/.bash.d/neovim.sh } } ]
        }

        best-ps1: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         src: bash.d/ps1.sh  dst: ~/.bash.d/ps1.sh } ]
        }
    }
    splash: random
}
