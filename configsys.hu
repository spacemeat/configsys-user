{
    components: {
        // apod: a PyPI CLI (termapod) installed via pipx. apod-dotfiles keeps its captured config
        // (the ~/.config/apod image cache). The shell HOOK that runs `termapod` on every interactive
        // shell is PARKED for now — see the "temporary orphans" block in dotfiles/bash_aliases
        // (which sources bash.d/apod.sh). termapod + the prompt are applications without
        // their own repo/version scheme yet; when they get real homes they leave bash_aliases.
        apod: {
            suggests: apod-dotfiles
            install: [ { via: pipx  name: termapod  version: { pypi: termapod } } ]
        }
        apod-dotfiles: {
            install: [ { via: dotfiles  config: { src: apod  dst: $XDG_CONFIG_HOME/apod } } ]
        }
        // (best-ps1 removed — parked into dotfiles/bash_aliases; see bash.d/ps1.sh.)
    }
    splash: random
    adopt-installed: true
    driver-preference: [ native  flatpak  snap  native-pkg-file  appImage  tarball  source  script ]
    picks: {
