{
    // Shared, git-synced profile definitions. Per-machine selection + overrides live in
    // ~/configsys.hu, which overlays this file section-by-section (see docs/routing-model.md).
    configs: [ ts-desktop  ts-laptop ]

    profiles: {
        ts-terminal: [ +terminal ]
        ts-text-editors: [ neovim ]
        ts-desktops-compositors: [ cosmic  gnome ]
        ts-web-browsers: [ chrome  firefox ]
        ts-audio-infra: [ +audio-infra ]
        ts-gaming: [ vulkan-runtime  steam ]
        ts-virtual-machines: [ +virtual-machines ]
        ts-containers: [ docker  docker-group  podman  lazydocker ]
        ts-db-clients: [ sqlitebrowser  lazysql ]
        ts-db-servers: [ sqlite ]
        ts-net-tools: [ dig  ethtool  iftop  iperf3  iproute2  mtr  netcat  nethogs  nload  nmap  socat  tcpdump  traceroute  tshark  vnstat  websocat  whois  wireshark  wireshark-group  mitmproxy ]
        ts-backend-tools: [ +containers  +net-tools  +db-clients  +db-servers ]
        ts-version-control-tools: [ git ]
        ts-compression-tools: [ zstd  lz4  p7zip  zip  unzip  unrar  rar ]
        ts-ai-tools: [ claude-code  ollama ]
        ts-dev-tools: [ +dev-tools ]
        ts-graphics-dev: [ vulkan-dev  gtk  gtkmm  qt  opengl  glfw  sdl  sfml ]
        ts-game-dev: [ +graphics-dev  godot  unityhub ]
        ts-c-cpp-lang: [ cmake  cpp-toolchain  gcc-10  gcc-11  gcc-12  gcc-13  gcc-14  gcc-15  gdb  clang-18  clang-19  clang-20  make  meson  ninja  analysis  eastl  boost  bison  flex  abseil  clang-select  clang-tidy  gcc-select  conan  cppcheck  heaptrack  pkg-config  fmt  gflags  glog  double-conversion  fast_float  expat  libevent  ncurses  qt  vcpkg ]
        ts-languages: [ +ts-c-cpp-lang  +dotnet-lang  +go-lang  +haskell-lang  +java-lang  +lisp-lang  +lua-lang  +ocaml-lang  +python-lang  +rust-lang  +web-lang  erlang  nim  nasm  octave  perl  zig ]
        ts-dev-science: [ octave  opencv  opencv-python  fastdds  jupyterlab ]
        ts-dev-web: [ prettier  postman ]
        ts-user: [ bash-dotfiles  configsys-dotfiles  apod  best-ps1  git  jmtpfs ]
        ts-desktop-gaming: [ steam  vulkan-runtime ]
        ts-desktop-graphics: [ vulkan-runtime  gimp  inkscape  krita  blender  freecad ]
        ts-desktop-electronics: [ arduino  kicad  ]
        ts-desktop-audio: [ ardour  lmms  tenacity  spotify ]
        ts-desktop-apps: [ discord  libreoffice  vlc ]
        ts-desktop-dev: [ +ts-dev-tools  +ts-game-dev  +ts-languages  +ts-dev-science  +ts-dev-web  +ts-net-tools ]
        ts-desktop: [ +ts-user  +ts-terminal  +ts-virtual-machines  +ts-containers  +ts-desktop-gaming  +ts-desktop-graphics  +ts-desktop-electronics  +ts-desktop-audio  +ts-desktop-apps  +ts-desktop-dev ]
        ts-laptop-graphics: [ blender  mesa-vulkan-drivers  gimp  inkscape  krita ]
        ts-laptop-electronics: [ arduino  gnuradio ]
        ts-laptop-audio: [ ardour  lmms  tenacity  spotify ]
        ts-laptop-apps: [ discord  libreoffice  vlc ]
        ts-laptop-dev: [ +ts-dev-tools  +ts-graphics-dev  +ts-languages  +ts-dev-web  +ts-net-tools ]
        ts-laptop: [ +ts-user  +ts-terminal  +ts-virtual-machines  +ts-containers  +ts-laptop-graphics  +ts-laptop-electronics  +ts-laptop-audio  +ts-laptop-apps  +ts-laptop-dev ]
        terminal-emulators: [ +terminal-emulators  ~alacritty ]
    }

    components: {
        // apod: a PyPI CLI (termapod) installed via pipx, plus a shell-startup dotfile.
        // `via: pipx` pulls the pipx TOOL (the driver's requires) — which is itself the
        // version-variant component above (pip-bootstrap on old Ubuntu/Debian, +EPEL on EL),
        // so this is a two-level tool chain. The inline dotfiles field runs termapod on every
        // interactive shell. (Old: linux `apod: [ pipx\apod, dotfiles\apod ]`.)
        apod: {
            suggests: apod-dotfiles
            install: [ { via: pipx  name: termapod  version: { pypi: termapod } } ]
        }
        apod-dotfiles: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         // src: bash.d/apod.sh  dst: ~/.bash.d/apod.sh } ]
                         config:  { src: apod  dst: $XDG_CONFIG_HOME/apod }
                         aliases: { glue: apod } } ]
        }

        /*
        neovim-dotfiles: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         config:  { src: neovim         dst: $XDG_CONFIG_HOME/nvim }
                         aliases: { src: bash.d/neovim.sh  dst: ~/.bash.d/neovim.sh } } ]
        }
        */

        best-ps1: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         //src: bash.d/ps1.sh  dst: ~/.bash.d/ps1.sh 
                         glue: ps1 } ]
        }
    }
    splash: random
}
