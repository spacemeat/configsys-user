{
    // Shared, git-synced profile definitions. Per-machine selection + overrides live in
    // ~/configsys.hu, which overlays this file section-by-section (see docs/routing-model.md).
    configs: [ ts-desktop  ts-laptop  c-cpp-libs  c-cpp-dev-libs ]

    profiles: {
        ts-finders: [ +finders ]
        ts-terminal-emulators: [ +terminal-emulators  ~foot  ~wezterm ]
        ts-terminal-utils: [ +terminal-utils ]
        ts-system-utils: [ +system-utils ]
        ts-system-monitors: [ +system-monitors  ~bottom  ~atop  ~bmon  ~s-tui  ~glances  ~wavemon  ~dstat  ~iotop ]
        ts-disk-usage-utils: [ +disk-usage-utils ]
        ts-file-browsers: [ +file-browsers  ~eza  ~mc  ~superfile ]
        ts-desktop-shells: [ +shells ]
        ts-laptop-shells: [ +shells  ~fish  ~nushell  ~zsh ]
        ts-configuration-tools: [ +configuration-tools  ~ansible  ~stow ]
        ts-password-passkey: []
        ts-fonts: [ +fonts ]
        ts-text-editors: [ +text-editors  ~android-studio  ~antigravity  ~emacs  ~helix  ~jetbrains-toolbox  ~jrnl  ~micro  ~vscode  ~vscodium  ~zed  ~fresh  ~asciidoc ]
        ts-communication: [ +communication  ~obs-studio ]
        ts-desktop-terminal: [ +ts-finders  +ts-terminal-emulators  +ts-terminal-utils  +ts-system-utils  +ts-system-monitors  +ts-disk-usage-utils  +ts-file-browsers  +ts-desktop-shells  +ts-configuration-tools  +ts-password-passkey  +ts-fonts  +ts-text-editors  +ts-communication ]
        ts-laptop-terminal: [ +ts-finders  +ts-terminal-emulators  +ts-terminal-utils  +ts-system-utils  +ts-system-monitors  +ts-disk-usage-utils  +ts-file-browsers  +ts-laptop-shells  +ts-configuration-tools  +ts-password-passkey  +ts-fonts  +ts-text-editors  +ts-communication ]
        ts-iso-image-tools: [ +iso-image-tools  ~caligula  balena-etcher ]
        ts-web-browsers: [ +web-browsers  chrome  ~chromium  firefox  ~brave  ~opera  ~vivaldi  ~edge  tor-browser  ~lynx ]
        ts-audio-infra: [ +audio-infra  pipewire  jack  wiremix ]
        ts-desktop-gaming: [ +gaming  ~wine  ~winetricks  ~protonup-qt  ~protontricks ]
        ts-laptop-gaming: [ +gaming  ~steam  ~wine  ~winetricks  ~protonup-qt  ~protontricks ]
        ts-games: [ +games ]
        ts-virtual-machines: [ +virtual-machines  ~virtualbox ]
        ts-containers: [ +containers  ~xephyr ]
        ts-db-servers: [ +db-servers  ~postgresql-service  ~mariadb-service  ~mongodb-service  ~mongodb ]
        ts-db-clients: [ +db-clients  ~pgcli  ~mycli  ~dbeaver  ~mongodb ]
        ts-net-tools: [ +net-tools  ~croc  ~wormhole  ~ttyd ]
        ts-desktop-basics: [ +ts-iso-image-tools  +ts-web-browsers  +ts-audio-infra  +ts-desktop-gaming  +ts-games  +ts-virtual-machines  +ts-containers  +ts-db-servers  +ts-db-clients  +ts-net-tools ]
        ts-laptop-basics: [ +ts-iso-image-tools  +ts-web-browsers  +ts-audio-infra  +ts-laptop-gaming  +ts-games  +ts-virtual-machines  +ts-containers  +ts-db-servers  +ts-db-clients  +ts-net-tools ]
        ts-languages: [ +languages  ~dotnet-lang  ~objective-c-lang  ~php-lang  +python-lang  ~ruby-lang  ~scratch-lang  ~elm  ~elixir  ~julia  ~r  ~gfortran  ~gnat  ~gnucobol  ~d  ~crystal  ~dart  ~raku  ~v  ~gleam  ~fennel  ~swift  ~racket  ~guile  ~deno  ~detekt ]
        ts-jvm-tools: [ +jvm-tools  ~mvnd  ~sdkman  ~ant  ~coursier  ~springboot  ~quarkus  ~micronaut  ~visualvm  ~jmc ]
        ts-jvm-dev: [ +jvm-dev ]
        ts-dev-tools: [ +dev-tools  ~ghidra  ~just  ~protobuf  ~liquibase  ~jenkins  ~obsidian  ~radare2  ~grex ]
        ts-autotools: [ +autotools ]
        ts-version-control-tools: [ +version-control-tools  ~cvs  ~perforce  ~fossil  ~bazaar ]
        ts-compression-tools: [ +compression-tools ]
        ts-desktop-compute-lang: [ +compute-lang  ~rocm-hip  ~intel-oneapi-basekit ]
        ts-desktop-deep-learning-lang: [ +deep-learning-lang  ~cudnn-9  ~miopen  ~onednn ]
        ts-laptop-compute-lang: []
        ts-laptop-deep-learning-lang: []
        ts-ai-tools: [ +ai-tools  ~codex  ~llm  ~aider  ~impala ]
        ts-web-tools: [ +web-tools  ~nginx ]
        ts-web-package-managers: [ +web-package-managers  ~pnpm  ~yarn ]
        ts-web-dev: [ +web-dev ]
        ts-ui-dev: [ +ui-dev  ~gtk  ~gtk3  ~gtkmm  ~libinput  ~pixman  ~libdecor  ~libx11  ~libxcb  ~xcb-util  ~libxcursor  ~libxft  ~libxi  ~libxinerama  ~libxkbcommon  ~libxrandr  ~libxxf86vm  ncurses  ~pango  qt  ~wayland  ~wayland-protocols  ~wlroots  ~wxpython  ~wxwidgets ]
        ts-graphics-dev: [ +graphics-dev ]
        ts-game-dev: [ +game-dev  ~godot  ~godl ]
        ts-desktop-dev: [ +ts-languages  +ts-jvm-dev  +ts-dev-tools  +ts-autotools  +ts-version-control-tools  +ts-compression-tools  +ts-desktop-compute-lang  +ts-desktop-deep-learning-lang  +ts-ai-tools  +ts-web-tools  +ts-web-package-managers  +ts-graphics-dev  +ts-game-dev ]
        ts-laptop-dev: [ +ts-languages  +ts-jvm-dev  +ts-dev-tools  +ts-autotools  +ts-version-control-tools  +ts-compression-tools  +ts-laptop-compute-lang  +ts-laptop-deep-learning-lang  +ts-ai-tools  +ts-web-tools  +ts-web-package-managers  +ts-graphics-dev  +ts-game-dev ]
        ts-desktop-electronics-tools: [ +electronics-tools ]
        ts-laptop-electronics-tools: [ +electronics-tools  ~kicad ]
        ts-desktop-graphics-tools: [ +graphics-tools  ~asciiquarium  ~cbonsai  ~durdraw  ~darktable  ~openscad  ~scribus  ~digikam  ~pipes  ~webcamize  ~wl-screenrec ]
        ts-laptop-graphics-tools: [ +graphics-tools  ~asciiquarium  ~cbonsai  ~durdraw  ~gimp  ~inkscape  ~darktable  ~freecad  ~openscad  ~pipes  ~scribus  ~digikam  ~webcamize  ~wl-screenrec ]
        ts-audio-tools: [ +audio-tools ]
        ts-desktop-science: [ +science  ~paraview  ~foldit ]
        ts-laptop-science: [ +science  ~paraview ]
        ts-desktop-math: [ +math  ~julia  ~r  ~pari  ~gap  ~gnuplot  ~sagemath  ~texlive-full  ~texlive ]
        ts-laptop-math: [ +math  ~julia  ~r  ~pari  ~gap  ~gnuplot  ~sagemath  ~texlive-full  ~texlive ]
        ts-media-servers: [ +media-servers  ~jellyfin-service  ~plex-service  ~emby-service  ~navidrome ]
        ts-media-players: [ +media-players ]
        ts-user: [ bash-dotfiles  configsys-dotfiles  apod  best-ps1  git  jmtpfs ]
        ts-desktop: [ +ts-desktop-terminal  +ts-desktop-basics  +ts-desktop-dev  +ts-desktop-electronics-tools  +ts-desktop-graphics-tools  +ts-audio-tools  +ts-desktop-science  +ts-desktop-math  +ts-media-servers  +ts-media-players  +ts-user  +ts-desktop-video-editors ]
        ts-laptop: [ +ts-laptop-terminal  +ts-laptop-basics  +ts-laptop-dev  +ts-laptop-electronics-tools  +ts-laptop-graphics-tools  +ts-audio-tools  +ts-laptop-science  +ts-laptop-math  +ts-media-servers  +ts-media-players  +ts-user ]
        ts-desktop-video-editors: [ +video-editors  ~asciinema  ~flowblade  ~olive  ~openshot  ~shotcut ]
        ts-desktop-benchmark-tools: [ +benchmark-tools  ~unigine-heaven  ~unigine-superposition  ~unigine-valley  ~wrk  ~phoronix-test-suite ]
        c-cpp-lang: [ +c-cpp-lang  ~vcpkg ]
    }

    components: {
        // apod: a PyPI CLI (termapod) installed via pipx, plus a shell-startup dotfile.
        // `via: pipx` pulls the pipx TOOL (the driver's requires) — which is itself the
        // version-variant component above (pip-bootstrap on old Ubuntu/Debian, +EPEL on EL),
        // so this is a two-level tool chain. The inline dotfiles field runs termapod on every
        // interactive shell. (Old: linux `apod: [ pipx\apod, dotfiles\apod ]`.)
        apod: {
            suggests: apod-dotfiles
            install: [ { via: pipx  name: termapod  version: { pypi: termapod } } ]
        }
        apod-dotfiles: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         // src: bash.d/apod.sh  dst: ~/.bash.d/apod.sh } ]
                         config:  { src: apod  dst: $XDG_CONFIG_HOME/apod }
                         aliases: { glue: apod } } ]
        }

        best-ps1: {
            install: [ { via: dotfiles  requires: bash-dotfiles
                         //src: bash.d/ps1.sh  dst: ~/.bash.d/ps1.sh 
                         glue: ps1 } ]
        }
    }
    splash: random
    adopt-installed: true
    driver-preference: [ native  flatpak  snap  native-pkg-file  appImage  tarball  source  script ]
}
